# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dev-only: skip the "different calendar day" unlock rule
NEXT_PUBLIC_DEV_TEST_MODE=false

# Accounts (Supabase). Leave both empty to run without sign-in.
# Project URL: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…); public, used in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret key (sb_secret_…). Server only: never NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Admin accounts, comma-separated Google emails (docs/decisions.md D5).
ADMIN_EMAILS=

# Creating practices (roadmap d, D28, D37). Server only: never
# NEXT_PUBLIC_, never commit. Each kind of call picks a vendor; creating is
# off unless both kinds have their keys.
# Language model (translation, notes, splitting, generated text):
# "azure" or "google" (default: google until Azure OpenAI is in).
AI_LANGUAGE_PROVIDER=
# Speech: "azure" (default) or "google".
AI_SPEECH_PROVIDER=
# Azure Speech, free F0 tier (docs/roadmap.md list 6C).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# Gemini API key from Google AI Studio (AI_LANGUAGE_PROVIDER=google).
GEMINI_API_KEY=
# Google Cloud key restricted to Cloud Text-to-Speech (AI_SPEECH_PROVIDER=google).
GOOGLE_CLOUD_API_KEY=
# "fake" = no API calls, for local development (ignored on the production
# site). Overrides everything above. D20.
AI_PROVIDERS=
