# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Dev-only: skip the "different calendar day" unlock rule
NEXT_PUBLIC_DEV_TEST_MODE=false

# Accounts (Supabase). Leave both empty to run without sign-in.
# Project URL: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…); public, used in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret key (sb_secret_…). Server only: never NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Admin accounts, comma-separated Google emails (docs/decisions.md D5).
ADMIN_EMAILS=

# Creating practices (roadmap d, D28, D37). Server only: never
# NEXT_PUBLIC_, never commit. Each kind of call picks a vendor; creating is
# off unless both kinds have their keys.
# Language model (translation, notes, splitting, generated text):
# "azure" (default) or "google".
AI_LANGUAGE_PROVIDER=
# Azure OpenAI (docs/roadmap.md list 6B). The model must be priced in
# lib/ai/pricing.ts and set up in lib/ai/azure-openai.ts, or it's off.
AZURE_OPENAI_ENDPOINT=https://listenloop-ai.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_MODEL=gpt-5-mini
# Speech: "azure" (default) or "google".
AI_SPEECH_PROVIDER=
# Azure Speech, free F0 tier (docs/roadmap.md list 6C).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# Gemini API key from Google AI Studio (AI_LANGUAGE_PROVIDER=google).
GEMINI_API_KEY=
# Google Cloud key restricted to Cloud Text-to-Speech (AI_SPEECH_PROVIDER=google).
GOOGLE_CLOUD_API_KEY=
# "fake" = no API calls, for local development (ignored on the production
# site). Overrides everything above. D20.
AI_PROVIDERS=

# Payments (D85, docs/payments.md). "fake" = the test provider: no money,
# never used on the production site. Empty = payments off ("coming soon").
PAYMENTS_PROVIDER=
# Signs the provider's webhooks (any long random string for "fake").
PAYMENTS_WEBHOOK_SECRET=

# YouTube practices (D97, D129): a YouTube Data API v3 key (Google Cloud
# console, restricted to the YouTube Data API). Without it the "YouTube
# link" option is hidden from learners (admins see a setup note). Free
# (quota only); no billing needed. On Vercel: Production (and Preview if
# you test there). /admin/usage → "Test connection" checks it for free.
YOUTUBE_API_KEY=
# Practice reminders (D111): web push keys from `npx web-push generate-vapid-keys`.
# The public key turns the setting on; the private key is only for the
# reminder job (GitHub Actions). VAPID_SUBJECT: a mailto: or https: contact.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Real-user analytics (D148): Microsoft Clarity's project id (Settings →
# Setup). Empty: no cookie notice and nothing loaded. Loaded only after a
# visitor accepts analytics cookies.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Monitoring (D156): the shared secret the GitHub Actions monitor sends to
# /api/cron/* (`openssl rand -hex 32`; set the same value as a GitHub
# secret). Empty: the cron routes don't exist. DISCORD_WEBHOOK_URL: a
# Discord channel's webhook for alerts; empty: alerts stay on /admin/ops.
CRON_SECRET=
DISCORD_WEBHOOK_URL=

# Bot check (D160): Cloudflare Turnstile's keys (free). Both empty: off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Search engines (D167, docs/seo.md). NEXT_PUBLIC_SITE_URL: the site's
# public address for canonical links, hreflang, the sitemap, and share
# images (empty: https://listenloop-three.vercel.app); change it when the
# site moves to its own domain. The verification tokens are the "content"
# of the HTML-tag method in Google Search Console and Bing Webmaster
# Tools; empty: no tag.
NEXT_PUBLIC_SITE_URL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Android app (Trusted Web Activity, D178, docs/twa.md): served as
# /.well-known/assetlinks.json. TWA_PACKAGE_NAME is android/twa-manifest.json's
# packageId; TWA_SHA256_FINGERPRINTS lists, comma-separated, the upload
# key's SHA-256 (keytool) and Google Play's app signing key's SHA-256 (Play
# Console → App integrity). Fingerprints aren't secret. Empty: [].
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINTS=
