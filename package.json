{
  "name": "listenloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "NEXT_PUBLIC_SUPABASE_URL=http://localhost:${MOCK_SUPABASE_PORT:-54329} NEXT_PUBLIC_SUPABASE_ANON_KEY=e2e-publishable-key NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLsUJzGppWi2Z5kjA6ZBOSimvBNrePc2_PaS5rCsLXIXFLVCGWkZx4dxxDCMQrj3d6mOCkl1txnEM3oogAIUCgU next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "video:new": "node scripts/new-video.mts",
    "video:sync": "node scripts/sync-excerpts.mts",
    "db:push": "npx supabase@3.0.0 db push --remote",
    "db:types": "npx supabase@3.0.0 gen types typescript --linked > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts",
    "voices:samples": "node --env-file=.env.local scripts/voice-samples.mts",
    "ai:record": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.record.config.mts --silent=false",
    "eval": "vitest run --config vitest.eval.config.mts --silent=false",
    "eval:check": "EVAL_MODE=check vitest run --config vitest.eval.config.mts --silent=false",
    "eval:record": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.eval-record.config.mts --silent=false",
    "official:drafts": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.official.config.mts --silent=false",
    "backgrounds:css": "node --no-warnings scripts/backgrounds-css.mts",
    "themes:contrast": "node --no-warnings scripts/themes-contrast.mts",
    "blender:drafts": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.blender.config.mts --silent=false",
    "content:fixes": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.fixes.config.mts --silent=false",
    "official:audit": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.audit.config.mts --silent=false",
    "news:make": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.news.config.mts --silent=false",
    "rls:check": "node --env-file=.env.local scripts/rls-check.mts",
    "db:backup": "node --env-file=.env.local scripts/backup-db.mts",
    "notes:upgrade": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.upgrade.config.mts --silent=false",
    "subtitles:record": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.subtitles.config.mts --silent=false",
    "usability": "playwright test --config usability/playwright.config.ts",
    "qa": "playwright test --config qa/playwright.config.ts",
    "portfolio:screenshots": "node --env-file=.env.local scripts/portfolio-screenshots.mts",
    "qa:summary": "node qa/summary.mts",
    "dev:metrics": "node scripts/dev-metrics.mts",
    "actions:usage": "node scripts/actions-usage.mts",
    "loadtest": "bash loadtest/run.sh",
    "marketing:docx": "node scripts/marketing-docx.mts",
    "size:functions": "node --no-warnings scripts/function-sizes.mts",
    "vercel:prune": "node --no-warnings scripts/vercel-prune.mts"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "docx": "9.15.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "0.8.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "web-push": "3.6.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": ">=24"
  }
}
