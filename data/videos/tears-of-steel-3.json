  "grammar": [
    {
      "sentence": 0,
      "point": "名詞 + left",
      "explanation": "left 是 leave 的過去分詞，放在名詞後面表示「剩下的」。Two minutes left 等於 There are two minutes left。",
      "example": "We have ten dollars left."
    },
    {
      "sentence": 4,
      "point": "That's no reason to + 原形動詞",
      "explanation": "用 no + 名詞（no reason）比 not a reason 語氣更強，表示「那根本不是……的理由」。",
      "example": "Being tired is no reason to be rude."
    },
    {
      "sentence": 6,
      "point": "already + 過去式",
      "explanation": "美式口語常用過去式搭配 already（We already tried）；英式比較常用現在完成式（We have already tried）。",
      "example": "I already ate lunch."
    },
    {
      "sentence": 10,
      "point": "should just + 原形動詞",
      "explanation": "表示「乾脆……算了」，帶有衝動或無奈的語氣。",
      "example": "Maybe I should just stay home."
    },
    {
      "sentence": 20,
      "point": "the world's changed：'s = has（現在完成式）",
      "explanation": "'s 可以是 is 也可以是 has。後面接過去分詞（changed）時是 has，表示「已經變了」，強調到現在的結果。",
      "example": "She's finished her homework."
    },
    {
      "sentence": 23,
      "point": "名詞 + to be + 過去分詞",
      "explanation": "a lesson to be learned 是「一個要被學到的教訓」。不定詞的被動式（to be + 過去分詞）放在名詞後面修飾它。",
      "example": "There's a lot of work to be done."
    },
    {
      "sentence": 24,
      "point": "could have + 過去分詞",
      "explanation": "表示「過去本來可能……（但實際上沒有）」。口語常縮寫成 could've，聽起來像 could'a。句首省略了主詞 It。",
      "example": "It could have been worse. Nobody got hurt."
    }
  ]
