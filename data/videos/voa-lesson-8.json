  "grammar": [
    {
      "sentence": 5,
      "point": "現在進行式：am / is / are + V-ing",
      "explanation": "表示說話的這一刻正在做的事。I am recording 就是「我正在錄音」。",
      "example": "I am talking on the phone right now."
    },
    {
      "sentence": 5,
      "point": "When + 子句, 主要子句",
      "explanation": "when 帶出「當……的時候」。when 子句放在句首時，後面要加逗號。",
      "example": "When it rains, I stay home."
    },
    {
      "sentence": 6,
      "point": "Sorry about + 名詞",
      "explanation": "為某件事道歉。about 後面接名詞（yesterday、the noise）；接動作時常用 Sorry for + V-ing。",
      "example": "Sorry about the noise last night."
    },
    {
      "sentence": 8,
      "point": "May I + 原形動詞?",
      "explanation": "禮貌地請求許可，比 Can I…? 更正式客氣。",
      "example": "May I use your pen?"
    }
  ]
