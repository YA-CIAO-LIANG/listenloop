  "grammar": [
    {
      "sentence": 6,
      "point": "Come on, + 祈使句",
      "explanation": "Come on 放在命令句前面，催促對方「快點」；也可以用來鼓勵對方。",
      "example": "Come on, hurry up! We're late."
    },
    {
      "sentence": 8,
      "point": "（There's）nothing to + 原形動詞",
      "explanation": "口語常省略 There's。nothing to worry about 意思是「沒有需要擔心的事」，to 加原形動詞用來修飾 nothing。",
      "example": "There's nothing to eat in the fridge."
    },
    {
      "sentence": 13,
      "point": "Be + 形容詞（祈使句）",
      "explanation": "要求對方「保持某種態度」時，用 Be 開頭再加形容詞，例如 Be tender、Be honest。否定是 Don't be + 形容詞。",
      "example": "Be careful! Don't be late."
    },
    {
      "sentence": 15,
      "point": "remind + 人 + 疑問詞子句",
      "explanation": "remind 後面先接人，再接 what、where 等疑問詞帶出的子句。子句用直述句的語序：what love is，不是 what is love。",
      "example": "Can you remind me where the station is?"
    },
    {
      "sentence": 21,
      "point": "have to + 原形動詞",
      "explanation": "表示「必須、不得不」，多半是因為外在的情況或規定。",
      "example": "I have to finish my homework tonight."
    },
    {
      "sentence": 22,
      "point": "just want to + 原形動詞",
      "explanation": "just 放在動詞前面，表示「只是、只想」，語氣比較輕。",
      "example": "I just want to sleep."
    }
  ]
