  "grammar": [
    {
      "sentence": 3,
      "point": "call + 人 + 名字",
      "explanation": "表示「稱呼某人為……」。受詞後面直接接名字，不需要加 as。",
      "example": "Everyone calls him Teddy."
    },
    {
      "sentence": 7,
      "point": "Are you + 形容詞?",
      "explanation": "be 動詞問句，問對方的感受或狀態。回答用 Yes, I am. 或 No, I'm not.",
      "example": "Are you tired? Yes, I am."
    },
    {
      "sentence": 9,
      "point": "So sorry, but + 子句",
      "explanation": "先道歉，再用 but 說明原因，是委婉拒絕或打斷別人的常用說法。So sorry 是 I'm so sorry 的口語省略。",
      "example": "So sorry, but I can't come to your party."
    },
    {
      "sentence": 9,
      "point": "be busy + V-ing",
      "explanation": "表示「忙著做某事」，busy 後面直接接動名詞（V-ing），不需要加介系詞。",
      "example": "She is busy doing her homework."
    }
  ]
