  "grammar": [
    {
      "sentence": 3,
      "point": "I'm feeling + 形容詞",
      "explanation": "用進行式說「此刻」的感受。也可以用簡單式 I feel homesick，意思差不多。",
      "example": "I'm feeling tired today."
    },
    {
      "sentence": 4,
      "point": "Do you want to + 原形動詞?",
      "explanation": "詢問對方想不想做某事，也常用來提出邀請或建議。",
      "example": "Do you want to get lunch together?"
    },
    {
      "sentence": 6,
      "point": "簡答：Yes, you do.",
      "explanation": "用助動詞 do 代替前面說過的動詞片語（have some photos），避免重複。",
      "example": "Do you like coffee? Yes, I do."
    },
    {
      "sentence": 10,
      "point": "make + 人 + 原形動詞",
      "explanation": "使役用法，表示「讓某人做某事」。make 後面的動詞用原形，不加 to。",
      "example": "Sad movies always make me cry."
    }
  ]
